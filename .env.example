# GroundedSearch local development configuration
#
# Copy this file to .env for local development.
# Never commit the resulting .env file.

GROUNDEDSEARCH_ENV=development
LOG_LEVEL=info

SEARCH_API_HOST=0.0.0.0
SEARCH_API_PORT=8080
REQUEST_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s

ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8090
ML_SERVICE_URL=http://localhost:8090
ML_SERVICE_TIMEOUT=2s
